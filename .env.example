# Copy to .env and fill in. .env is gitignored — never commit real values.
# Keep LF line endings if you `source` this in WSL/bash.

# --- Model route -------------------------------------------------------------
# Required: Anthropic API key for model calls and skill uploads
ANTHROPIC_API_KEY=

# Optional: Custom Anthropic base URL (defaults to SDK standard if not set)
# ANTHROPIC_BASE_URL=

# --- Observability -----------------------------------------------------------
# LangWatch tracing (enabled by default)
LANGWATCH_DISABLED=false
LANGWATCH_API_KEY=
LANGWATCH_ENDPOINT_URL=

# FastAPI owns Postgres. Agents POST each step here; FastAPI writes the rows.
BACKEND_URL=http://127.0.0.1:8000

# --- MCP tools (optional) ----------------------------------------------------
# Comment out to run the agents without MCP. Don't set it empty.
MCP_SERVER=http://127.0.0.1:8080/mcp

# --- Worker queue ------------------------------------------------------------
# Redis the agents put sub-tasks on and the worker pool (run_workers.py) reads from.
REDIS_URL=redis://localhost:6379
# Seconds an agent waits for one sub-task result before marking it failed.
# SUBTASK_TIMEOUT=300
# Sub-tasks one worker-pool process runs at once.
# WORKER_CONCURRENCY=10
