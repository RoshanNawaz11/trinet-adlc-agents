# Copy to .env and fill in. .env is gitignored — never commit real values.
# Keep LF line endings if you `source` this in WSL/bash.

# --- Model route -------------------------------------------------------------
# Model calls: agents → LiteLLM → Cloudflare AI Gateway → Anthropic.
LITELLM_BASE_URL=http://localhost:4000
# Only needed if LiteLLM has a master key; otherwise any value (or none) works.
# ANTHROPIC_API_KEY=

# Skill uploads (list/create/new version) go straight to the Cloudflare AI Gateway.
ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-id>/anthropic
ANTHROPIC_GATEWAY_TOKEN=

# --- Observability -----------------------------------------------------------
# true = the agents send nothing to LangWatch; LiteLLM is the only tracer.
LANGWATCH_DISABLED=true
# Only if you turn the flag off and want the agents to trace themselves:
# LANGWATCH_API_KEY=
# LANGWATCH_ENDPOINT_URL=http://localhost:5560

# --- MCP tools (optional) ----------------------------------------------------
# Comment out to run the agents without MCP. Don't set it empty.
MCP_SERVER=http://127.0.0.1:8080/mcp

# --- Worker queue ------------------------------------------------------------
# Redis the agents put sub-tasks on and the worker pool (run_workers.py) reads from.
REDIS_URL=redis://localhost:6379
# Seconds an agent waits for one sub-task result before marking it failed.
# SUBTASK_TIMEOUT=300
# Sub-tasks one worker-pool process runs at once.
# WORKER_CONCURRENCY=10
