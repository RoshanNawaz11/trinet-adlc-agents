# Copy to .env and fill in. .env is gitignored — never commit real values.
# Keep LF line endings if you `source` this in WSL/bash.

# --- Model route -------------------------------------------------------------
# LiteLLM route (recommended): set BOTH. The key is only a switch here (any
# non-empty value); the real credentials live in LiteLLM's own .env.
ANTHROPIC_API_KEY=sk-litellm-placeholder
LITELLM_BASE_URL=http://localhost:4000

# Cloudflare AI Gateway (BYOK), used directly when LITELLM_BASE_URL is NOT set.
# USE_CLOUDFLARE_AIG=true
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-id>/anthropic
# ANTHROPIC_GATEWAY_TOKEN=

# Direct Anthropic: unset LITELLM_BASE_URL and put a real key in ANTHROPIC_API_KEY.

# Custom CA (corporate / Cloudflare). Ignored if the file doesn't exist.
# SSL_CA_BUNDLE=/path/to/ca-bundle.pem

# --- Observability -----------------------------------------------------------
# true = the agents send nothing to LangWatch; LiteLLM is the only tracer.
LANGWATCH_DISABLED=true
# Only if you turn the flag off and want the agents to trace themselves:
# LANGWATCH_API_KEY=
# LANGWATCH_ENDPOINT_URL=http://localhost:5560

# --- MCP tools (optional) ----------------------------------------------------
# Comment out to run the agents without MCP. Don't set it empty.
MCP_SERVER=http://127.0.0.1:8080/mcp
